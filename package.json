{
  "name": "history-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=react-native-client",
    "android": "npm run android --workspace=react-native-client",
    "ios": "npm run ios --workspace=react-native-client",
    "db:push": "cd packages/shared && prisma db push",
    "client": "npm start --workspace=react-native-client",
    "client:local": "npm run start:local --workspace=react-native-client",
    "client:feature": "npm run start:feature --workspace=react-native-client",
    "client:dev": "npm run start:dev --workspace=react-native-client",
    "server": "npm run build:shared && npm run dev --workspace=express-server",
    "download-sdks": "node apps/react-native-client/scripts/downloadSDKs.js",
    "nuke": "rimraf node_modules package-lock.json apps/react-native-client/node_modules apps/express-server/node_modules apps/react-native-client/android apps/react-native-client/ios packages/shared/src/generated",
    "setup": "npm run nuke && npm install && npx prisma generate --schema=packages/shared/prisma/schema.prisma && cd apps/react-native-client && npx expo prebuild",
    "build": "npm run build:render",
    "build:shared": "npm run build --workspace=@history-app/shared",
    "build:server": "npm run build --workspace=express-server",
    "build:render": "npm install && npx prisma generate --schema=packages/shared/prisma/schema.prisma && npm run build:shared && npm run build:server",
    "start:render": "node apps/express-server/dist/index.js",
    "dev": ""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "cloudinary": "^2.10.0",
    "expo": "~56.0.20",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "rimraf": "^6.1.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "expo-constants": "56.0.24",
    "react-native-safe-area-context": "5.7.0",
    "@expo/log-box": "56.0.12"
  }
}