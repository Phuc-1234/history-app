{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",                 
    "moduleResolution": "nodenext",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
   "typeRoots": ["../../node_modules/@types"]
  },
  "include": ["src/**/*"]
}