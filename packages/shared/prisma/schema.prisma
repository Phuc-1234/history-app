generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Grade {
  id        Int           @id
  state     HierachyState @default(PUBLIC)
  questions Question[]
  tests     Test[]
  topics    Topic[]

  @@map("grades")
}

model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  position  Int
  gradeId   Int        @map("grade_id")
  lessons   Lesson[]
  questions Question[]
  tests     Test[]
  grade     Grade      @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@map("topics")
}

model Lesson {
  id         Int         @id @default(autoincrement())
  name       String
  summary    String?
  position   Int
  topicId    Int         @map("topic_id")
  flashcards Flashcard[]
  topic      Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions  Question[]
  sections   Section[]
  tests      Test[]
  videos     Video[]
  mindMap    MindMap?

  @@map("lessons")
}

model MindMap {
  id        Int     @id @default(autoincrement())
  lessonId  Int     @unique @map("lesson_id")
  data      Json
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("mind_maps")
}

model Video {
  id        String      @id @default(uuid())
  lessonId  Int?        @map("lesson_id")
  title     String
  position  Int
  summary   String?
  hlsUrl    String      @map("hls_url")
  duration  Float?
  status    VideoStatus @default(PENDING)
  createdAt DateTime    @default(now()) @map("created_at")
  lesson    Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("videos")
}

model Section {
  id              Int         @id @default(autoincrement())
  name            String
  summary         String?
  position        Int
  lessonId        Int         @map("lesson_id")
  parentSectionId Int?        @map("parent_section_id")
  flashcards      Flashcard[]
  nodes           Node[]
  questions       Question[]
  lesson          Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parentSection   Section?    @relation("SectionHierarchy", fields: [parentSectionId], references: [id])
  childSections   Section[]   @relation("SectionHierarchy")
  tests           Test[]

  @@map("sections")
}

model Node {
  id         Int         @id @default(autoincrement())
  position   Int
  header     String?
  body       String
  imgUrl     String?     @map("img_url")
  sectionId  Int         @map("section_id")
  flashcards Flashcard[]
  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@map("nodes")
}

model Flashcard {
  id             Int             @id @default(autoincrement())
  frontText      String          @map("front_text")
  backText       String          @map("back_text")
  lessonId       Int?            @map("lesson_id")
  sectionId      Int?            @map("section_id")
  nodeId         Int?            @map("node_id")
  lesson         Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  node           Node?           @relation(fields: [nodeId], references: [id])
  section        Section?        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  userFlashcards UserFlashcard[]

  @@map("flashcards")
}

model UserFlashcard {
  id               Int       @id @default(autoincrement())
  remainingReviews Int       @default(2) @map("remaining_reviews")
  position         Int
  frontText        String    @map("front_text")
  backText         String    @map("back_text")
  userId           String    @map("user_id")
  flashcardId      Int       @map("flashcard_id")
  flashcard        Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_flashcards")
}

model Test {
  id             String         @id @default(dbgenerated("gen_random_uuid()"))
  isManual       Boolean        @default(false) @map("is_manual")
  isNationalTest Boolean        @default(false) @map("is_national_test")
  questionNumber Int            @default(10) @map("question_number")
  timeLimit      Int?           @map("time_limit")
  xpReward       Int            @default(0) @map("xp_reward")
  goldReward     Int            @default(0) @map("gold_reward")
  passThreshold  Int            @default(70) @map("pass_threshold")
  gradeId        Int?           @map("grade_id")
  topicId        Int?           @map("topic_id")
  lessonId       Int?           @map("lesson_id")
  sectionId      Int?           @map("section_id")
  title          String
  summary        String?        @default("Kiểm tra kiến thức của bạn")
  testQuestions  TestQuestion[]
  grade          Grade?         @relation(fields: [gradeId], references: [id])
  lesson         Lesson?        @relation(fields: [lessonId], references: [id])
  section        Section?       @relation(fields: [sectionId], references: [id])
  topic          Topic?         @relation(fields: [topicId], references: [id])
  userTestLogs   UserTestLog[]

  @@map("tests")
}

model Question {
  id             Int              @id @default(autoincrement())
  type           QuestionType
  difficulty     Int              @default(1)
  promptText     String           @map("prompt_text")
  gradeId        Int?             @map("grade_id")
  topicId        Int?             @map("topic_id")
  lessonId       Int?             @map("lesson_id")
  sectionId      Int?             @map("section_id")
  nodeId         Int?             @map("node_id")
  document       String?
  answers        QuestionAnswer[]
  grade          Grade?           @relation(fields: [gradeId], references: [id])
  lesson         Lesson?          @relation(fields: [lessonId], references: [id])
  node           Node?            @relation(fields: [nodeId], references: [id])
  section        Section?         @relation(fields: [sectionId], references: [id])
  topic          Topic?           @relation(fields: [topicId], references: [id])
  testQuestions  TestQuestion[]
  userAnswerLogs UserAnswerLog[]

  @@map("questions")
}

model QuestionAnswer {
  id            Int      @id @default(autoincrement())
  content       String
  isCorrect     Boolean? @map("is_correct")
  leftText      String?  @map("left_text")
  rightText     String?  @map("right_text")
  correctAnswer String?  @map("correct_answer")
  questionId    Int      @map("question_id")
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_answers")
}

model TestQuestion {
  testId     String   @map("test_id")
  questionId Int      @map("question_id")
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
  @@map("test_questions")
}

model User {
  id               String          @id @default(uuid())
  role             UserRole        @default(STUDENT)
  name             String
  email            String          @unique
  totalXp          Int             @default(0) @map("total_xp")
  totalGold        Int             @default(0) @map("total_gold")
  isHidden         Boolean         @default(false) @map("is_hidden")
  profileImgUrl    String?         @map("profile_img_url")
  currentStreak    Int             @default(0) @map("current_streak")
  highestStreak    Int             @default(0) @map("highest_streak")
  lastTestPassedAt DateTime?       @map("last_test_passed_at")
  currentTierIndex Int             @default(1) @map("current_tier_index")
  pendingRewards   PendingReward[]
  userFlashcards   UserFlashcard[]
  userItems        UserItem[]
  testLogs         UserTestLog[]
  tier             Tier            @relation(fields: [currentTierIndex], references: [index])
  isVerified       Boolean         @default(false) @map("is_verified")
  @@map("users")
}

model Tier {
  index       Int     @id
  name        String
  badgeImgUrl String? @map("badge_img_url")
  description String?
  xpThreshold Int     @map("xp_threshold")
  users       User[]

  @@map("tiers")
}

model UserTestLog {
  id                    String          @id @default(uuid())
  score                 Int
  startedAt             DateTime        @default(now()) @map("started_at")
  submittedAt           DateTime?       @map("submitted_at")
  isPassed              Boolean         @map("is_passed")
  goldEarned            Int             @default(0) @map("gold_earned")
  xpEarned              Int             @default(0) @map("xp_earned")
  attemptNumber         Int             @map("attempt_number")
  testId                String          @map("test_id")
  userId                String          @map("user_id")
  questionSequenceJson  Json?           @map("question_sequence_json")
  timezoneOffsetMinutes Int             @map("timezone_offset_minutes")
  answerLogs            UserAnswerLog[]
  test                  Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_test_logs")
}

model UserAnswerLog {
  id             Int          @id @default(autoincrement())
  userTestLogId  String       @map("user_test_log_id")
  questionId     Int          @map("question_id")
  type           QuestionType
  answerDataJson Json         @map("answer_data_json")
  question       Question     @relation(fields: [questionId], references: [id])
  testLog        UserTestLog  @relation(fields: [userTestLogId], references: [id], onDelete: Cascade)

  @@index([userTestLogId])
  @@index([questionId])
  @@map("user_answer_logs")
}

model Item {
  id               Int               @id @default(autoincrement())
  cost             Int?              @default(0)
  isConsumable     Boolean           @map("is_consumable")
  isPurchaseable   Boolean           @map("is_purchaseable")
  imgUrl           String?           @map("img_url")
  description      String?
  type             ItemType
  value            Float?
  testLimit        Int?              @map("test_limit")
  timeLimit        Int?              @map("time_limit")
  name             String
  milestoneRewards MilestoneReward[]
  pendingRewards   PendingReward[]
  userItems        UserItem[]

  @@map("items")
}

model UserItem {
  userId     String    @map("user_id")
  itemId     Int       @map("item_id")
  quantity   Int       @default(1)
  isActive   Boolean   @default(false) @map("is_active")
  activateAt DateTime? @map("activate_at")
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@map("user_items")
}

model PendingReward {
  id           Int              @id @default(autoincrement())
  goldAmount   Int              @default(0) @map("gold_amount")
  xpAmount     Int              @default(0) @map("xp_amount")
  itemQuantity Int              @default(0) @map("item_quantity")
  sourceType   RewardSourceType @map("source_type")
  sourceValue  Int              @map("source_value")
  isClaimed    Boolean          @default(false) @map("is_claimed")
  userId       String           @map("user_id")
  itemId       Int?             @map("item_id")
  rewardType   RewardType       @map("reward_type")
  item         Item?            @relation(fields: [itemId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_rewards")
}

model MilestoneReward {
  id           Int              @id @default(autoincrement())
  goldAmount   Int              @default(0) @map("gold_amount")
  xpAmount     Int              @default(0) @map("xp_amount")
  itemQuantity Int              @default(1) @map("item_quantity")
  sourceType   RewardSourceType @map("source_type")
  sourceValue  Int              @map("source_value")
  itemId       Int?             @map("item_id")
  name         String
  rewardType   RewardType       @map("reward_type")
  item         Item?            @relation(fields: [itemId], references: [id])

  @@map("milestone_rewards")
}

enum HierachyState {
  PUBLIC
  PRIVATE
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum QuestionType {
  CHOOSE
  FILL
  MATCH
}

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum ItemType {
  FRAME
  BOOST_XP_TIME
  BOOST_GOLD_TIME
  BOOST_XP_PASS
  BOOST_GOLD_PASS
}

enum RewardSourceType {
  STREAK
  TIER
}

enum RewardType {
  ITEM
  XP
  GOLD
}
