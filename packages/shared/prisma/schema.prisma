model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  senderId  String?  @map("sender_id")
  targetId  String?  @map("target_id")
  type      String   // e.g., "FRIEND_REQUEST", "FRIEND_ACCEPT", "SYSTEM"
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  sender    User?    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, isHidden])
  @@index([senderId])
  @@map("notifications")
}

model FcmToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("fcm_tokens")
}

enum AiChatMode {
  COURSE_ONLY
  COURSE_FIRST
  GENERAL
}

enum AiModelTier {
  LOW
  MEDIUM
  HIGH
}

model AiChatSession {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  title     String
  mode      AiChatMode      @default(GENERAL)
  modelTier AiModelTier     @default(MEDIUM) @map("model_tier")
  summary   String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  AiChatMessage[]

  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id            String        @id @default(uuid())
  sessionId     String        @map("session_id")
  sender        String        // "user" | "assistant"
  content       String        @db.Text
  screenContext Json?         @map("screen_context")
  createdAt     DateTime      @default(now()) @map("created_at")

  session       AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ai_chat_messages")
}

model UserAiQuota {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  date       String   // "YYYY-MM-DD" in UTC+7
  tokensUsed Int      @default(0) @map("tokens_used")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@map("user_ai_quotas")
}

enum PvpRoomStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model PvpRoom {
  id                   String           @id @default(uuid())
  code                 String
  hostUserId           String           @map("host_user_id")
  status               PvpRoomStatus    @default(LOBBY)
  questionCount        Int              @default(10) @map("question_count")
  timePerQuestion      Int              @default(15) @map("time_per_question")
  autoNext             Boolean          @default(true) @map("auto_next")
  transitionInterval   Int              @default(4) @map("transition_interval")
  questionSequenceJson Json             @map("question_sequence_json")
  currentQuestionIndex Int              @default(0) @map("current_question_index")
  isPublic             Boolean          @default(true) @map("is_public")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  host                 User             @relation("HostPvpRooms", fields: [hostUserId], references: [id], onDelete: Restrict)
  participants         PvpParticipant[]

  @@index([code, status])
  @@map("pvp_rooms")
}

model PvpParticipant {
  id          String   @id @default(uuid())
  roomId      String   @map("room_id")
  userId      String   @map("user_id")
  score       Float    @default(0)
  answersJson Json     @default("[]") @map("answers_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  room        PvpRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([roomId, userId])
  @@map("pvp_participants")
}

enum FeedbackStatus {
  PENDING
  RESOLVED
  IGNORED
}

model UserStudyReminder {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  isEnabled    Boolean  @default(true) @map("is_enabled")
  times        Json     @default("[\"20:00\"]")
  lastSentSlot String?  @map("last_sent_slot")
  lastCategory String?  @map("last_category")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_study_reminders")
}
