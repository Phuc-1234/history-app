generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model flashcards {
  id              Int               @id @default(autoincrement())
  front_text      String
  back_text       String
  lesson_id       Int?
  section_id      Int?
  node_id         Int?
  lessons         lessons?          @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  nodes           nodes?            @relation(fields: [node_id], references: [id])
  sections        sections?         @relation(fields: [section_id], references: [id], onDelete: Cascade)
  user_flashcards user_flashcards[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model follows {
  id                                String   @id
  follower_id                       String
  following_id                      String
  created_at                        DateTime @default(now())
  users_follows_follower_idTousers  users    @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade)
  users_follows_following_idTousers users    @relation("follows_following_idTousers", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@index([following_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model friend_requests {
  id                                       String              @id
  sender_id                                String
  receiver_id                              String
  status                                   FriendRequestStatus @default(PENDING)
  created_at                               DateTime            @default(now())
  updated_at                               DateTime
  users_friend_requests_receiver_idTousers users               @relation("friend_requests_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade)
  users_friend_requests_sender_idTousers   users               @relation("friend_requests_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade)

  @@unique([sender_id, receiver_id])
  @@index([receiver_id, status])
  @@index([sender_id, status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model friendships {
  id                                 String   @id
  user_id                            String
  friend_id                          String
  created_at                         DateTime @default(now())
  users_friendships_friend_idTousers users    @relation("friendships_friend_idTousers", fields: [friend_id], references: [id], onDelete: Cascade)
  users_friendships_user_idTousers   users    @relation("friendships_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, friend_id])
  @@index([friend_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model gold_purchases {
  id                String          @id
  user_id           String
  gold_amount       Int
  amount_vnd        Int
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  provider_order_id String          @unique
  provider_trans_id String?
  created_at        DateTime        @default(now())
  updated_at        DateTime
  users             users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model grades {
  id        Int           @id
  state     HierachyState @default(PUBLIC)
  questions questions[]
  tests     tests[]
  topics    topics[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model items {
  id                Int                 @id @default(autoincrement())
  cost              Int?                @default(0)
  is_consumable     Boolean
  is_purchaseable   Boolean
  img_url           String?
  description       String?
  type              ItemType
  value             Float?
  test_limit        Int?
  time_limit        Int?
  name              String
  milestone_rewards milestone_rewards[]
  pending_rewards   pending_rewards[]
  user_items        user_items[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lessons {
  id         Int          @id @default(autoincrement())
  name       String
  summary    String?
  position   Int
  topic_id   Int
  flashcards flashcards[]
  topics     topics       @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  mind_maps  mind_maps?
  questions  questions[]
  sections   sections[]
  tests      tests[]
  videos     videos[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model milestone_rewards {
  id            Int              @id @default(autoincrement())
  gold_amount   Int              @default(0)
  xp_amount     Int              @default(0)
  item_quantity Int              @default(1)
  source_type   RewardSourceType
  source_value  Int
  item_id       Int?
  name          String
  reward_type   RewardType
  items         items?           @relation(fields: [item_id], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mind_maps {
  id        Int     @id @default(autoincrement())
  lesson_id Int     @unique
  data      Json
  lessons   lessons @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model nodes {
  id                 Int                  @id @default(autoincrement())
  position           Int
  header             String?
  body               String
  section_id         Int
  img_url            String?
  video_id           String?
  flashcards         flashcards[]
  sections           sections             @relation(fields: [section_id], references: [id], onDelete: Cascade)
  videos             videos?              @relation(fields: [video_id], references: [id])
  questions          questions[]
  user_node_progress user_node_progress[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pending_rewards {
  id            Int              @id @default(autoincrement())
  gold_amount   Int              @default(0)
  xp_amount     Int              @default(0)
  item_quantity Int              @default(0)
  source_type   RewardSourceType
  source_value  Int
  is_claimed    Boolean          @default(false)
  user_id       String
  item_id       Int?
  reward_type   RewardType
  items         items?           @relation(fields: [item_id], references: [id])
  users         users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model question_answers {
  id             Int       @id @default(autoincrement())
  content        String
  is_correct     Boolean?
  left_text      String?
  right_text     String?
  correct_answer String?
  question_id    Int
  questions      questions @relation(fields: [question_id], references: [id], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id               Int                @id @default(autoincrement())
  type             QuestionType
  difficulty       Int                @default(1)
  prompt_text      String
  grade_id         Int?
  topic_id         Int?
  lesson_id        Int?
  section_id       Int?
  node_id          Int?
  document         String?
  answer_data_json Json?
  explanation      String?
  is_active        Boolean            @default(true)
  scope_id         Int?
  scope_type       ScopeType?
  question_answers question_answers[]
  grades           grades?            @relation(fields: [grade_id], references: [id])
  lessons          lessons?           @relation(fields: [lesson_id], references: [id])
  nodes            nodes?             @relation(fields: [node_id], references: [id])
  sections         sections?          @relation(fields: [section_id], references: [id])
  topics           topics?            @relation(fields: [topic_id], references: [id])
  test_questions   test_questions[]
  user_answer_logs user_answer_logs[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model scope_test_preset_defaults {
  scope_type             ScopeType
  purpose_type           PurposeType
  default_test_preset_id String
  test_presets           test_presets @relation(fields: [default_test_preset_id], references: [id])

  @@id([scope_type, purpose_type])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sections {
  id                Int          @id @default(autoincrement())
  name              String
  summary           String?
  position          Int
  lesson_id         Int
  parent_section_id Int?
  flashcards        flashcards[]
  nodes             nodes[]
  questions         questions[]
  lessons           lessons      @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  sections          sections?    @relation("sectionsTosections", fields: [parent_section_id], references: [id])
  other_sections    sections[]   @relation("sectionsTosections")
  tests             tests[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model test_presets {
  id                         String                       @id
  name                       String
  purpose_type               PurposeType
  question_count             Int?
  pass_threshold             Int                          @default(80)
  time_limit                 Int?
  difficulty_ratio_json      Json?
  scope_test_preset_defaults scope_test_preset_defaults[]
  tests                      tests[]
  user_test_logs             user_test_logs[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model test_questions {
  test_id     String
  question_id Int
  position    Int
  questions   questions @relation(fields: [question_id], references: [id], onDelete: Cascade)
  tests       tests     @relation(fields: [test_id], references: [id], onDelete: Cascade)

  @@id([test_id, question_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tests {
  id               String           @id @default(dbgenerated("gen_random_uuid()"))
  is_national_test Boolean          @default(false)
  grade_id         Int?
  topic_id         Int?
  lesson_id        Int?
  section_id       Int?
  title            String
  summary          String?          @default("Kiểm tra kiến thức của bạn")
  gold_reward      Int              @default(0)
  is_manual        Boolean          @default(false)
  pass_threshold   Int              @default(70)
  question_number  Int              @default(10)
  time_limit       Int?
  xp_reward        Int              @default(0)
  preset_id        String?
  scope_id         Int?
  scope_type       ScopeType?
  test_questions   test_questions[]
  grades           grades?          @relation(fields: [grade_id], references: [id])
  lessons          lessons?         @relation(fields: [lesson_id], references: [id])
  test_presets     test_presets?    @relation(fields: [preset_id], references: [id])
  sections         sections?        @relation(fields: [section_id], references: [id])
  topics           topics?          @relation(fields: [topic_id], references: [id])
  user_test_logs   user_test_logs[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tiers {
  index         Int     @id
  name          String
  badge_img_url String?
  description   String?
  xp_threshold  Int
  users         users[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model topics {
  id        Int         @id @default(autoincrement())
  name      String
  position  Int
  grade_id  Int
  lessons   lessons[]
  questions questions[]
  tests     tests[]
  grades    grades      @relation(fields: [grade_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_answer_logs {
  id               Int            @id @default(autoincrement())
  user_test_log_id String
  question_id      Int
  type             QuestionType
  answer_data_json Json
  answered_at      DateTime?      @default(now())
  max_score        Float?
  score_awarded    Float?
  questions        questions      @relation(fields: [question_id], references: [id])
  user_test_logs   user_test_logs @relation(fields: [user_test_log_id], references: [id], onDelete: Cascade)

  @@index([question_id])
  @@index([user_test_log_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_flashcards {
  id                Int        @id @default(autoincrement())
  remaining_reviews Int        @default(2)
  position          Int
  front_text        String
  back_text         String
  user_id           String
  flashcard_id      Int
  flashcards        flashcards @relation(fields: [flashcard_id], references: [id], onDelete: Cascade)
  users             users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_items {
  user_id     String
  item_id     Int
  quantity    Int       @default(1)
  is_active   Boolean   @default(false)
  activate_at DateTime?
  items       items     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, item_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_node_progress {
  user_id            String
  node_id            Int
  studied_at         DateTime?
  threshold          Float?
  all_test_passed_at DateTime?
  node_completed_at  DateTime?
  nodes              nodes     @relation(fields: [node_id], references: [id], onDelete: Cascade)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, node_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_test_logs {
  id                       String             @id
  score                    Int
  started_at               DateTime           @default(now())
  submitted_at             DateTime?
  is_passed                Boolean?
  attempt_number           Int
  test_id                  String?
  user_id                  String
  question_sequence_json   Json?
  timezone_offset_minutes  Int
  gold_earned              Int                @default(0)
  xp_earned                Int                @default(0)
  current_question_index   Int?               @default(0)
  draft_answer_json        Json?
  expires_at               DateTime?
  generated_from_preset_id String?
  max_score                Float?
  pass_threshold           Int?
  purpose_type             PurposeType?
  question_count           Int?
  scope_id                 Int?
  scope_type               ScopeType?
  score_awarded            Float?
  status                   TestStatus?
  time_limit               Int?
  user_answer_logs         user_answer_logs[]
  test_presets             test_presets?      @relation(fields: [generated_from_preset_id], references: [id])
  tests                    tests?             @relation(fields: [test_id], references: [id], onDelete: Cascade)
  users                    users              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                                                 String               @id
  role                                               UserRole             @default(STUDENT)
  name                                               String
  email                                              String               @unique
  total_xp                                           Int                  @default(0)
  total_gold                                         Int                  @default(0)
  is_hidden                                          Boolean              @default(false)
  profile_img_url                                    String?
  current_streak                                     Int                  @default(0)
  highest_streak                                     Int                  @default(0)
  last_test_passed_at                                DateTime?
  current_tier_index                                 Int                  @default(1)
  is_verified                                        Boolean              @default(false)
  is_private                                         Boolean              @default(false)
  allow_follow                                       Boolean              @default(true)
  allow_friend_request                               Boolean              @default(true)
  follows_follows_follower_idTousers                 follows[]            @relation("follows_follower_idTousers")
  follows_follows_following_idTousers                follows[]            @relation("follows_following_idTousers")
  friend_requests_friend_requests_receiver_idTousers friend_requests[]    @relation("friend_requests_receiver_idTousers")
  friend_requests_friend_requests_sender_idTousers   friend_requests[]    @relation("friend_requests_sender_idTousers")
  friendships_friendships_friend_idTousers           friendships[]        @relation("friendships_friend_idTousers")
  friendships_friendships_user_idTousers             friendships[]        @relation("friendships_user_idTousers")
  gold_purchases                                     gold_purchases[]
  pending_rewards                                    pending_rewards[]
  user_flashcards                                    user_flashcards[]
  user_items                                         user_items[]
  user_node_progress                                 user_node_progress[]
  user_test_logs                                     user_test_logs[]
  tiers                                              tiers                @relation(fields: [current_tier_index], references: [index])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model videos {
  id         String      @id
  lesson_id  Int?
  title      String
  position   Int
  summary    String?
  hls_url    String
  duration   Float?
  status     VideoStatus @default(PENDING)
  created_at DateTime    @default(now())
  nodes      nodes[]
  lessons    lessons?    @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum HierachyState {
  PUBLIC
  PRIVATE
}

enum ItemType {
  FRAME
  BOOST_XP_TIME
  BOOST_GOLD_TIME
  BOOST_XP_PASS
  BOOST_GOLD_PASS
}

enum PaymentProvider {
  MOMO
  ZALOPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PurposeType {
  EXAM
  PRACTICE
}

enum QuestionType {
  CHOOSE
  FILL
  MATCH
}

enum RewardSourceType {
  STREAK
  TIER
}

enum RewardType {
  ITEM
  XP
  GOLD
}

enum ScopeType {
  GRADE
  TOPIC
  LESSON
  SECTION
  NODE
  NATIONAL
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}
