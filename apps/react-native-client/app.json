{
  "expo": {
    "name": "Sắc Sử",
    "slug": "history-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/true_app_icon.png",
    "scheme": "historyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "newArchEnabled": false
    },
    "android": {
      "package": "com.historyapp",
      "googleServicesFile": "./google-services.json",
      "newArchEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F6",
        "foregroundImage": "./assets/images/true_app_icon_foreground.png",
        "monochromeImage": "./assets/images/true_app_icon_foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "android": {
            "image": "./assets/images/true_app_icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow this app to access the microphone to listen to your speech answers during automated testing workflows.",
          "speechRecognitionPermission": "Allow this app to use speech recognition to process your voice commands during tests."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-fbsdk-next",
        {
          "appID": "2080338002838929",
          "clientToken": "eedf7b3618b89a6ee7111695505acb63",
          "displayName": "History App"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-asset",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
