        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "98412896-ba54-4947-87d0-7b9968904d2e",
                "exec": [
                  "// 1. Parse the incoming response JSON payload\r",
                  "const responseData = pm.response.json();\r",
                  "\r",
                  "// 2. Extract the access token (adjust the path based on your exact response structure)\r",
                  "const token = responseData.accessToken || responseData.session?.accessToken;\r",
                  "const ref_token = responseData.refreshToken || responseData.session?.refreshToken;\r",
                  "if (token && ref_token) {\r",
                  "    // 3. Save it automatically into your current active environment vault\r",
                  "    pm.environment.set(\"accessToken\", token);\r",
                  "    pm.environment.set(\"refreshToken\", ref_token); // Save refresh token as well if needed\r",
                  "    console.log(\"Token successfully captured and saved to environment!\");\r",
                  "} else {\r",
                  "    console.warn(\"Could not find access_token in the response payload.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
